        <mxCell id="el17" value="Решение OPA, ключи,&#10;учётные записи и аудит&#10;TLS; отказ при неизвестном" style="text;html=0;align=center;verticalAlign=middle;fontSize=13;fontColor=#354a60;fillColor=#ffffff;strokeColor=none;whiteSpace=wrap;" parent="1" vertex="1">
